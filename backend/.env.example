# Copiar a .env y completar PGPASSWORD localmente. .env esta excluido de Git.
# Usa la misma contrasena que asignes con \password blue_fragancias_app.
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=blue_fragancias
PGUSER=blue_fragancias_app
PGPASSWORD=

# Solo al desplegar: origen HTTPS exacto del frontend (varios, separados por coma).
# ADMIN_ORIGINS=https://tu-dominio
# NODE_ENV=production activa cookies Secure. Requiere HTTPS.
